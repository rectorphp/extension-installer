{
    "name": "rector/extension-installer",
    "type": "composer-plugin",
    "description": "Composer plugin for automatic installation of Rector extensions",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.7",
        "composer/xdebug-handler": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector-src": "^2.4",
        "symplify/easy-coding-standard": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Rector\\RectorInstaller\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rector\\RectorInstaller\\Tests\\": "tests"
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "phpstan": "vendor/bin/phpstan analyse --ansi"
    },
    "repositories": [
        {
            "type": "path",
            "version": "dev-main",
            "url": "."
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "class": "Rector\\RectorInstaller\\Plugin",
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
